{
  "$defs": {
    "DataQuality": {
      "enum": [
        "ok",
        "degraded",
        "unusable",
        "unknown"
      ],
      "title": "DataQuality",
      "type": "string"
    },
    "DeviceStatus": {
      "enum": [
        "ok",
        "fault",
        "unknown"
      ],
      "title": "DeviceStatus",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to an immutable raw artifact. Omit the list until the artifact exists.",
      "properties": {
        "uri": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "mediaTimeS": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mediatimes"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Fields every task must carry when it emits a result or an observation.",
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceModality"
        },
        "deviceId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Deviceid",
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "title": "Observedat",
          "type": "string"
        },
        "receivedAt": {
          "format": "date-time",
          "title": "Receivedat",
          "type": "string"
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "timeQuality": {
          "$ref": "#/$defs/TimeQuality"
        },
        "modelVersion": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelversion"
        },
        "deviceStatus": {
          "$ref": "#/$defs/DeviceStatus",
          "default": "unknown"
        },
        "siteId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Siteid"
        },
        "channelId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channelid"
        },
        "clockOffsetMs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clockoffsetms"
        },
        "evidenceRefs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidencerefs",
          "type": "array"
        }
      },
      "required": [
        "source",
        "deviceId",
        "observedAt",
        "receivedAt",
        "dataQuality",
        "timeQuality"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceModality": {
      "enum": [
        "radar",
        "rf",
        "eo"
      ],
      "title": "SourceModality",
      "type": "string"
    },
    "TimeQuality": {
      "enum": [
        "synchronized",
        "estimated",
        "unsynchronized",
        "unknown"
      ],
      "title": "TimeQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Polar radar measurement before conversion to an Observation.",
  "properties": {
    "schemaVersion": {
      "default": "shared.radar-plot/1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "plotId": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Plotid",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "sessionId": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Sessionid",
      "type": "string"
    },
    "frameIndex": {
      "minimum": 0,
      "title": "Frameindex",
      "type": "integer"
    },
    "rangeM": {
      "title": "Rangem",
      "type": "number"
    },
    "azimuthDeg": {
      "title": "Azimuthdeg",
      "type": "number"
    },
    "elevationDeg": {
      "title": "Elevationdeg",
      "type": "number"
    },
    "radialVelocityMps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Radialvelocitymps"
    },
    "snrDb": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snrdb"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "pointStatusFlags": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pointstatusflags"
    },
    "validity": {
      "enum": [
        "valid",
        "invalid_flags",
        "out_of_range"
      ],
      "title": "Validity",
      "type": "string"
    }
  },
  "required": [
    "plotId",
    "provenance",
    "sessionId",
    "frameIndex",
    "rangeM",
    "azimuthDeg",
    "elevationDeg",
    "validity"
  ],
  "title": "RadarPlot",
  "type": "object"
}
